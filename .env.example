# Serene Bay — weekly insight automation. Copy to `.env` for local runs.
# `.env` is gitignored. In the Claude routine these live in the environment
# config, not in the repo.

# ── Where the Serene site lives ────────────────────────────────────
# Absolute path to a clone of luismayrina/serene-2. The publish step writes
# content/insights/<slug>.md and public/images/<slug>-*.webp into this repo,
# then opens a pull request against it.
SERENE_REPO_PATH="/Users/you/dev/serene-2"
# Branch the PR targets. `beta` today; `main` once beta is merged.
SERENE_BASE_BRANCH="beta"

# ── Images ─────────────────────────────────────────────────────────
# Whichever key is present is used; FAL_KEY wins if both are set, because that
# is what the live cloud environment carries. Put the real value in the
# environment's "API credentials" section, NOT in this variables box.
FAL_KEY=""
OPENAI_API_KEY=""
# "false" skips image generation entirely and publishes text only.
INCLUDE_IMAGES="true"

# ── Review notification ────────────────────────────────────────────
# Teams inbound webhook. A failed run posts {"event":"run_failed",...} here.
POWERAUTOMATE_WEBHOOK_URL=""

# ── GitHub ─────────────────────────────────────────────────────────
# GITHUB_TOKEN is used by setup.sh to clone the site repo over HTTPS, and by
# `gh` if it is available. It is a secret: it belongs in the environment's
# "API credentials" section, not in the plaintext variables box.
#
# Note: the GitHub REST API is blocked by the cloud proxy (403), so opening the
# pull request may fail. That is handled: the branch is pushed regardless and
# the routine opens the draft PR with the GitHub MCP tools instead.
GITHUB_TOKEN=""
