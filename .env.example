# Serene Bay — weekly insight automation. Copy to `.env` for local runs.
# `.env` is gitignored. In the Claude routine these live in the environment
# config, not in the repo.

# ── Where the Serene site lives ────────────────────────────────────
# Absolute path to a clone of luismayrina/serene-2. The publish step writes
# content/insights/<slug>.md and public/images/<slug>-*.webp into this repo,
# then opens a pull request against it.
SERENE_REPO_PATH="/Users/you/dev/serene-2"
# Branch the PR targets. `beta` today; `main` once beta is merged.
SERENE_BASE_BRANCH="beta"

# ── Images ─────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# "false" skips image generation entirely and publishes text only.
INCLUDE_IMAGES="true"

# ── Review notification ────────────────────────────────────────────
# Teams inbound webhook. A failed run posts {"event":"run_failed",...} here.
POWERAUTOMATE_WEBHOOK_URL=""

# ── GitHub ─────────────────────────────────────────────────────────
# The PR is opened with the `gh` CLI, which must already be authenticated
# (gh auth login). No token is read from this file.
