# Serene Bay — weekly insight automation. Copy to `.env` for local runs.
# `.env` is gitignored. In the Claude routine these live in the environment
# config, not in the repo.

# ── Where the Serene site lives ────────────────────────────────────
# Absolute path to a clone of rothian-ai/serene-2. The publish step writes
# content/insights/<slug>.md and public/images/<slug>-*.webp into this repo,
# then opens a pull request against it.
SERENE_REPO_PATH="/Users/you/dev/serene-2"
# Branch the PR targets. `beta` today; `main` once beta is merged.
SERENE_BASE_BRANCH="beta"
# Author email for the draft commit. Vercel only builds a preview for a commit
# whose author it recognises (see serene-2/.github/DEPLOYING.md).
SERENE_COMMIT_EMAIL="71801164+luismayrina@users.noreply.github.com"

# ── Images ─────────────────────────────────────────────────────────
# Whichever key is present is used; FAL_KEY wins if both are set, because that
# is what the live cloud environment carries. Put the real value in the
# environment's "API credentials" section, NOT in this variables box.
FAL_KEY=""
OPENAI_API_KEY=""
# "false" skips image generation entirely and publishes text only.
INCLUDE_IMAGES="true"

# ── Review notification ────────────────────────────────────────────
# Teams inbound webhook. A failed run posts {"event":"run_failed",...} here.
POWERAUTOMATE_WEBHOOK_URL=""

# ── GitHub ─────────────────────────────────────────────────────────
# GITHUB_TOKEN is used by setup.sh to clone the site repo over HTTPS, and by
# `gh` if it is available. It is a secret: it belongs in the environment's
# "API credentials" section, not in the plaintext variables box.
#
# Note: the GitHub REST API is blocked by the cloud proxy (403), so opening the
# pull request may fail. That is handled: the branch is pushed regardless and
# the routine opens the draft PR with the GitHub MCP tools instead.
GITHUB_TOKEN=""

# ── Google Business Profile poster (post_to_gbp.py) ────────────────
# Run gbp_auth.py once, on your own computer, signed in as the profile's
# owner: it prints the refresh token and the two IDs. The client ID, client
# secret and refresh token are secrets: put them under API credentials.
GBP_CLIENT_ID=""
GBP_CLIENT_SECRET=""
GBP_REFRESH_TOKEN=""
GBP_ACCOUNT_ID=""
GBP_LOCATION_ID=""
# Only insights dated on or after this are posted, so the back catalogue that
# predates the automation is left alone. Set it once, to the day you switch on.
GBP_POST_SINCE="2026-11-05"
# The serene-2 branch that is production (serene-2/.github/DEPLOYING.md).
SERENE_LIVE_BRANCH="beta"

# Sitemap source, for a profile whose articles are not in serene-2 (Rothian).
# When GBP_SITEMAP_URL is set, SERENE_REPO_PATH is not used.
GBP_SITEMAP_URL=""          # e.g. https://www.rothian.com/sitemap.xml
GBP_PATH_PREFIX="/insights/"
GBP_SITE_NAME="Serene Bay"  # names the site in Teams messages
